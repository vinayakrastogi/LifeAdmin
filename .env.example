# Generate a secret: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Use the same value in PyLearn's backend environment. Never put this in Vite variables.
LIFEADMIN_API_KEY=
LIFEADMIN_SOURCE_APP=pylearn
# Create/update the two requested presentation accounts at API/UI startup.
LIFEADMIN_SEED_DEMO_USERS=true
# Hosted API and Streamlit UI must use the SAME PostgreSQL URL (Neon pooled URL, sslmode=require).
# Keep blank for local SQLite. This is independent of edT's DATABASE_URL.
LIFEADMIN_DATABASE_URL=
# ngrok belongs to the account hosting LifeAdmin. Keep the real authtoken local.
NGROK_AUTHTOKEN=
NGROK_DOMAIN=polygon-coastal-glazing.ngrok-free.dev
# Optional absolute path; the API and Streamlit must use the same path.
# LIFEADMIN_DB=/absolute/path/to/LifeAdmin/data/lifeadmin.db
